# Real file ONLY at /var/www/Pettycash/shared/production.env, mode 600.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARS
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=pettycash.windowasia.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pettycash.windowasia.com
PUBLIC_BASE_URL=https://pettycash.windowasia.com
POSTGRES_DB=pettycash
POSTGRES_USER=pettycash
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
PC_INTEGRATIONS_ENABLED=false
AD_GATEWAY_URL=
AD_APP_ID=
AD_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Verify live VPS values; APEX source alone is not proof.
TRAEFIK_NETWORK=REPLACE_WITH_VERIFIED_NETWORK
TRAEFIK_ENTRYPOINT=REPLACE_WITH_VERIFIED_TLS_ENTRYPOINT
TRAEFIK_CERTRESOLVER=REPLACE_WITH_VERIFIED_RESOLVER
